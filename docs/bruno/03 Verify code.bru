meta {
  name: Verify code
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/method/fieldpro.api.v1.auth.verify_otp
  body: json
  auth: none
}

body:json {
  { "mobile_no": "{{mobile}}", "code": "{{code}}" }
}

script:post-response {
  if (res.status === 200) bru.setEnvVar("token", res.body.message.data.token);
}
